tgiven":[{"game_id":28,"givento":"GBR Open U20","cat1":3,"cat2":2,"cat3":3,"cat4":3,"cat5":3,"total":14,"comments":"Very spirited, we talked about fouls and celebrations, and they followed through with what they said. A really great game, all calls were talked through well, and resolved fast."},{"game_id":27,"givento":"AUS Open U20","cat1":2,"cat2":1,"cat3":2,"cat4":1,"cat5":2,"total":8,"comments":"We talked about less physicality before the game, yet they still were pretty physical and not completely spatially aware, some dangerous plays. Good communication and we talked through calls."},{"game_id":26,"givento":"SGP Open U20","cat1":2,"cat2":3,"cat3":3,"cat4":4,"cat5":2,"total":14,"comments":"We gave a 4 for attitude and self control because they were the most spirited team many of us had played, and were so friendly and apologized for calls they thought were wrong. Nothing dangerous and great body control. "},{"game_id":25,"givento":"SUI Open U20","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":"Very good all around, great fair mindedness and good communication and spirit."},{"game_id":29,"givento":"COL Open U20","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"Some dangerous or risky plays, so a 1 in that category. All other aspects were good. "},{"game_id":30,"givento":"FRA Open U20","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"Some fouls and some grabbing on defense. Everything else was good."},{"game_id":125,"givento":"JPN Open U20","cat1":2,"cat2":3,"cat3":3,"cat4":3,"cat5":3,"total":14,"comments":"Very good all around. Great spirit."},{"game_id":129,"givento":"ITA Open U20","cat1":2,"cat2":1,"cat3":3,"cat4":2,"cat5":2,"total":10,"comments":"Fouls on the mark, and some minor grabbing. Overall good spirit"}],"spiritreceived":[{"game_id":28,"givenby":"GBR Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":"Really fun game and very open and accepting to the differences in rule sets between usa and WFDF"},{"game_id":27,"givenby":"AUS Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Was a good game, USA were receptive of the request to reduce contact."},{"game_id":26,"givenby":"SGP Open U20","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":"We would like to thank USA for the amazing game, it was well spirited and all the calls were thought through, and one was retracted after talking it out. Thank you USA for a great game!"},{"game_id":25,"givenby":"SUI Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":29,"givenby":"COL Open U20","cat1":2,"cat2":1,"cat3":2,"cat4":3,"cat5":2,"total":10,"comments":null},{"game_id":30,"givenby":"FRA Open U20","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":3,"total":12,"comments":"Really nice game, fast communication throughout each call, very spirited outcome each time"},{"game_id":125,"givenby":"JPN Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":129,"givenby":"ITA Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":133,"givenby":"FRA Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null}],"spiritstats":{"games":8},"spirittotal":{"total":85}}