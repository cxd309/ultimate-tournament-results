t3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":61,"givento":"BEL Open U20","cat1":2,"cat2":2,"cat3":1,"cat4":2,"cat5":1,"total":8,"comments":"Their players never seemed open to an opposing perspective. Although they always \"listened\", we got the impression that once a call was made they wouldn't change their point of view."},{"game_id":58,"givento":"CAN Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":3,"total":12,"comments":null},{"game_id":51,"givento":"ITA Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":null},{"game_id":63,"givento":"GER Open U20","cat1":2,"cat2":1,"cat3":2,"cat4":1,"cat5":2,"total":8,"comments":"Several instances of avoidable contact after points were scored. Lots of aggression from one player in particular who was not willing to listen to apologies after minor, incidental contact. Their coach also showed poor self control."},{"game_id":142,"givento":"AUS Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":141,"givento":"SGP Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":140,"givento":"COL Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null}],"spiritreceived":[{"game_id":60,"givenby":"IRL Open U20","cat1":3,"cat2":3,"cat3":2,"cat4":2,"cat5":2,"total":12,"comments":"Thanks New Zealand for a great first game and a very spirited game, we had no major issues and any small issues were resolved quickly. Good luck in the rest of the tournament!!"},{"game_id":62,"givenby":"JPN Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":null},{"game_id":59,"givenby":"CHN Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":61,"givenby":"BEL Open U20","cat1":2,"cat2":3,"cat3":2,"cat4":2,"cat5":2,"total":11,"comments":null},{"game_id":58,"givenby":"CAN Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"very well spirited and calls were resolved quickly "},{"game_id":51,"givenby":"ITA Open U20","cat1":2,"cat2":2,"cat3":1,"cat4":2,"cat5":2,"total":9,"comments":null},{"game_id":63,"givenby":"GER Open U20","cat1":1,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":10,"comments":null},{"game_id":142,"givenby":"AUS Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":141,"givenby":"SGP Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":1,"total":9,"comments":"We felt that when calls were made, there could be more talking out between both sides, and allow the players involved in the call to speak before teammates or sidelines step in. Also perhaps there was slightly higher body contact levels but i think we were ok with that. Otherwise, thank you New Zealand for the game!"},{"game_id":140,"givenby":"COL Open U20","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":"Good spirit game but it was difficult to explain the rules, they don't have the mood to understand and learn"}],"spiritstats":{"games":10},"spirittotal":{"total":103}}