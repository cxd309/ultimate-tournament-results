ndry","num":23,"games":10},{"player_id":181,"firstname":"Devon","lastname":"Bringeland-Powell","num":88,"games":10}],"spiritgiven":[{"game_id":20,"givento":"Italy Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":null},{"game_id":19,"givento":"Chinese Taipei Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":21,"givento":"Colombia Open","cat1":2,"cat2":2,"cat3":1,"cat4":2,"cat5":2,"total":9,"comments":null},{"game_id":111,"givento":"Germany Open","cat1":2,"cat2":1,"cat3":1,"cat4":1,"cat5":2,"total":7,"comments":"It was a windy game which generally means more contact, however there were several examples of bids going through our players, and one bad jump into our player with position.\r\nThe discussions regarding contested calls were generally composed, but there was minimal consideration to our perspective. It felt like the default was to contest a call regardless of other perspectives.\r\nWhen these examples were brought to the attention of your team, there was laughter and a dismissive attitude."},{"game_id":106,"givento":"Great Britain Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":"We appreciate the game. Thanks GB"},{"game_id":109,"givento":"Belgium Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":167,"givento":"France Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":"Fantastic game. Thank you France."},{"game_id":172,"givento":"United States of America Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":178,"givento":"Colombia Open","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":3,"total":12,"comments":null},{"game_id":182,"givento":"Germany Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":"Great game. A lot of respect. Thank you Germany."}],"spiritreceived":[{"game_id":20,"givenby":"Italy Open","cat1":2,"cat2":2,"cat3":2,"cat4":1,"cat5":2,"total":9,"comments":"Talking with the team some episodes from the side-line came up that were not perceived as spirited, other than that a normal game."},{"game_id":19,"givenby":"Chinese Taipei Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":21,"givenby":"Colombia Open","cat1":2,"cat2":2,"cat3":2,"cat4":1,"cat5":2,"total":9,"comments":"There were 2 bad reactions from 2 different players. We encourage them to be careful with this kind of behaviors. Also, the level of physicality was high from both parts, but their level was somehow over our proposition. We recommend that they be more careful on jumping into the lane of the players without the frisbee, and not making bids when they’ve already do not have a play on the disc. Thanks for a very well played and hard fought game"},{"game_id":111,"givenby":"Germany Open","cat1":1,"cat2":2,"cat3":2,"cat4":1,"cat5":3,"total":9,"comments":" Great communication, early and a lot !! Didn’t like the attitude of some players and coaches. !!  Shoutout to Stony for the best Attitude and being super friendly!! "},{"game_id":106,"givenby":"Great Britain Open","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":3,"total":12,"comments":null},{"game_id":109,"givenby":"Belgium Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":167,"givenby":"France Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":172,"givenby":"United States of America Open","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":null},{"game_id":178,"givenby":"Colombia Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Canada, congrats on the win. Thanks for a very well communicated game and for being aware of the level of physicality proposed by us. Go win 5th! "},{"game_id":182,"givenby":"Germany Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":"Thank you for a great laste game ! "}],"spiritstats":{"games":10},"spirittotal":{"total":101}}