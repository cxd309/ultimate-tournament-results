{"team_id":26,"pool":29,"valid":1,"players":[{"player_id":587,"firstname":"SHING TO","lastname":"LEE","num":97,"games":9},{"player_id":588,"firstname":"YUI TO WALTON","lastname":"LEE","num":77,"games":9},{"player_id":589,"firstname":"JOSHUA","lastname":"KEIL","num":88,"games":9},{"player_id":590,"firstname":"LEWIS","lastname":"GLOVER","num":17,"games":9},{"player_id":591,"firstname":"CHARM HAY BUZZ","lastname":"SZETO","num":24,"games":9},{"player_id":592,"firstname":"CHEUK HIM","lastname":"SIU","num":99,"games":9},{"player_id":593,"firstname":"CHUN ALEXIS","lastname":"AU YEUNG","num":8,"games":9},{"player_id":594,"firstname":"CHRIS TSZ LONG","lastname":"CHEUNG","num":52,"games":9},{"player_id":595,"firstname":"JOSEPH","lastname":"LEUNG","num":21,"games":9},{"player_id":596,"firstname":"CHAK LUN","lastname":"LEUNG","num":0,"games":9},{"player_id":597,"firstname":"CHONG KIN","lastname":"CHAU","num":86,"games":9},{"player_id":598,"firstname":"KA YUEN","lastname":"CHEUNG","num":20,"games":9},{"player_id":599,"firstname":"CHUN TUNG","lastname":"AU","num":79,"games":8},{"player_id":600,"firstname":"WING KEI","lastname":"LAI","num":33,"games":3},{"player_id":601,"firstname":"TSZ KAM","lastname":"TSE","num":16,"games":8},{"player_id":602,"firstname":"WILSON","lastname":"WONG","num":10,"games":9},{"player_id":603,"firstname":"ANTHONY","lastname":"PHAN","num":11,"games":9},{"player_id":604,"firstname":"YU HIN","lastname":"LAU","num":22,"games":9},{"player_id":605,"firstname":"SING HOI","lastname":"LIU","num":25,"games":9},{"player_id":606,"firstname":"HENRY","lastname":"HAN","num":12,"games":8}],"spiritgiven":[{"game_id":4,"givento":"Great Britain Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Could have avoided some of the contact on offensive players blindside - 2x in the game (one on run down, one in zone D). Well done on a strong opening performance though!"},{"game_id":1,"givento":"United States of America Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Good communication during calls and fair-mindedness (almost a 3!). Thanks for a fantastic, challenging game. Congratulations and good luck!"},{"game_id":6,"givento":"Austria Open","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"Felt there was still too much pushing in the play and stepping into/onto feet in running lanes. Congratulations on the win, throws in the wind were too good "},{"game_id":114,"givento":"France Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Good communication between Spirit Captains - adjusting the physicality during the game on both sides. Pls note there was one foul call which began with a bit of an aggressive discussion from France but appreciate the sideline stepping in to mediate. Thank you and all the best for the rest of the week!"},{"game_id":112,"givento":"Italy Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":"Good spirit overall, some contact on the disc when it popped in the air, but overall all calls were fair and made calmly. "},{"game_id":113,"givento":"Singapore Open","cat1":1,"cat2":1,"cat3":2,"cat4":3,"cat5":2,"total":9,"comments":"Overall team spirit was very good, and communication throughout the game was great. We felt towards the end there was unnecessary contact after catches on our players, this was localised to a few players but still would like to see it improved. Need clarification on repeated marking violations as this should be a foul and back to zero, also we felt some of the travel calls that were retracted were made unnecessarily. "},{"game_id":184,"givento":"New Zealand Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":190,"givento":"Chinese Taipei Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Just a few issues with double teams and disc space. But overall spirit was good. "},{"game_id":195,"givento":"Singapore Open","cat1":1,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"Some fast counts and contact off the disc, also need to watch the deliberate double team. Good communication and positive attitude, well played. "}],"spiritreceived":[{"game_id":4,"givenby":"Great Britain Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":1,"givenby":"United States of America Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":6,"givenby":"Austria Open","cat1":2,"cat2":2,"cat3":3,"cat4":3,"cat5":2,"total":12,"comments":null},{"game_id":114,"givenby":"France Open","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":null},{"game_id":112,"givenby":"Italy Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":113,"givenby":"Singapore Open","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":null},{"game_id":184,"givenby":"New Zealand Open","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":190,"givenby":"Chinese Taipei Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":195,"givenby":"Singapore Open","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null}],"spiritstats":{"games":9},"spirittotal":{"total":96}}