es":10},{"player_id":774,"firstname":"Reona","lastname":"Oshima","num":27,"games":10}],"spiritgiven":[{"game_id":60,"givento":"Switzerland Mixed","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":3,"total":12,"comments":"Thank you for nice and clean game.\r\nWe really enjoyed the game with you.\r\nYour fair-minded communication was great."},{"game_id":61,"givento":"Austria Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":null},{"game_id":58,"givento":"United States of America Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"We were glad to see the improvement in physical contact in the second half of the game!"},{"game_id":59,"givento":"Argentina Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":139,"givento":"Great Britain Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":140,"givento":"Germany Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":141,"givento":"Canada Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":1,"cat5":2,"total":9,"comments":"Some players were not willing to listen to others' opinions in post-call communication.\r\nSeveral players were on the sideline saying the \r\nF word and giving the middle finger."},{"game_id":209,"givento":"Australia Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":214,"givento":"Italy Mixed","cat1":1,"cat2":2,"cat3":1,"cat4":2,"cat5":2,"total":8,"comments":"Overall, there were many fast counts, and for some players, they did not improve during the game.\r\n\r\n When a call was made, there were several occasions when it seemed that the players were not willing to listen to our perspectives.\r\n\r\n There was no action taken by the team to recommend the withdrawal of a call in a situation that causes disadvantage to their team's own position."},{"game_id":219,"givento":"Germany Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":3,"total":11,"comments":null}],"spiritreceived":[{"game_id":60,"givenby":"Switzerland Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":61,"givenby":"Austria Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":"It often took you too long to get a translator"},{"game_id":58,"givenby":"United States of America Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":59,"givenby":"Argentina Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":139,"givenby":"Great Britain Mixed","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":"Thank you for a really enjoyable game despite the wind. We thought you were really fair minded and a lovely team to play against :) "},{"game_id":140,"givenby":"Germany Mixed","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":141,"givenby":"Canada Mixed","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"observed moments on the field where calls were made to slow the game down. Teammates over heard the opposing team telling their players in Japanese to make advantageous calls/over turn calls. Be aware of arms on the mark and upfield defense (players felt contact towards the head). "},{"game_id":209,"givenby":"Australia Mixed","cat1":2,"cat2":2,"cat3":4,"cat4":2,"cat5":3,"total":13,"comments":"You played an incredibly spirited game. Thank you for the respect and fair mindedness. You made multiple decisions to retract or accept calls after listening to our perspectives. The way you played was the perfect representation of sportsmanship. The communication in calls always made us feel listened to. Thank you to Minori for her extra work in the game to translate. Arigatou gozaimashitta."},{"game_id":214,"givenby":"Italy Mixed","cat1":1,"cat2":2,"cat3":1,"cat4":2,"cat5":1,"total":7,"comments":null},{"game_id":219,"givenby":"Germany Mixed","cat1":1,"cat2":2,"cat3":1,"cat4":3,"cat5":3,"total":10,"comments":"Thank you for the rematch! It was a pleasure playing you :)"}],"spiritstats":{"games":10},"spirittotal":{"total":105}}