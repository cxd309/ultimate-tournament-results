by":"Jurassic Pack","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":null},{"game_id":3908,"givenby":"PUC","cat1":2,"cat2":1,"cat3":2,"cat4":3,"cat5":2,"total":10,"comments":null},{"game_id":3907,"givenby":"One Tribe","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null}],"spiritstats":{"games":6},"spirittotal":{"total":57}}