:946,"firstname":"Tyler","lastname":"Hochhalter","num":86,"games":12}],"spiritgiven":[{"game_id":88,"givento":"Australia MX","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":3,"total":12,"comments":null},{"game_id":85,"givento":"India MX","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":null},{"game_id":86,"givento":"Mexico MX","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":null},{"game_id":90,"givento":"Great Britain MX","cat1":2,"cat2":2,"cat3":3,"cat4":3,"cat5":2,"total":12,"comments":null},{"game_id":87,"givento":"Colombia MX","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":2,"total":11,"comments":null},{"game_id":84,"givento":"Panama MX","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":82,"givento":"USA MX","cat1":1,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":null},{"game_id":89,"givento":"Japan MX","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"Lots of contact and dangerous play"},{"game_id":83,"givento":"Hong Kong, China MX","cat1":2,"cat2":3,"cat3":2,"cat4":3,"cat5":2,"total":12,"comments":"Great game!"},{"game_id":297,"givento":"Australia MX","cat1":2,"cat2":2,"cat3":3,"cat4":2,"cat5":2,"total":11,"comments":"Great game!"},{"game_id":300,"givento":"USA MX","cat1":2,"cat2":2,"cat3":1,"cat4":2,"cat5":2,"total":9,"comments":null},{"game_id":305,"givento":"Colombia MX","cat1":2,"cat2":1,"cat3":3,"cat4":2,"cat5":2,"total":10,"comments":null}],"spiritreceived":[{"game_id":88,"givenby":"Australia MX","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":"Contact in the end zone was a bit more than we are comfortable with. Some incorrect hand signals. But overall a great game, great communication, we had fun! Thanks Canada"},{"game_id":85,"givenby":"India MX","cat1":2,"cat2":2,"cat3":2,"cat4":1,"cat5":2,"total":9,"comments":"We had conversation with team Canada regarding spirit and attitude towards our players. \r\nSome of the sideline talk were demeaning towards our team, with specific comments towards our team's performance. We were unable to communicate that to the Canadian team, which we'll bring up with them tomorrow. There were no dangerous plays during the game and most fouls were talked thru well. We communicated about low physicality, but we felt some players were still physical during cuts. "},{"game_id":86,"givenby":"Mexico MX","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":90,"givenby":"Great Britain MX","cat1":2,"cat2":3,"cat3":2,"cat4":2,"cat5":2,"total":11,"comments":"Thank you so much for adapting so readily to our request of shoulder tapping! Great spirit throughout!"},{"game_id":87,"givenby":"Colombia MX","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":null},{"game_id":84,"givenby":"Panama MX","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":82,"givenby":"USA MX","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"We loved the grind this game. A lot of good communication and resulting of calls with hand signals. We had a couple of our handlers who had more contact and foul calls on the mark than usual with 4 in a single point from the same player. Overall great game! "},{"game_id":89,"givenby":"Japan MX","cat1":2,"cat2":2,"cat3":2,"cat4":1,"cat5":2,"total":9,"comments":"Thank you for your kind communication. But we think we could play a better game if we were more calm judges of what happened."},{"game_id":83,"givenby":"Hong Kong, China MX","cat1":2,"cat2":2,"cat3":2,"cat4":3,"cat5":3,"total":12,"comments":"Thank you Canada that was a really fun game, we really appreciated the effort from many players to play non-contact, many of us noticed an improvement from the beginning of the game to the end as you adjusted. Some felt there was contact all the way through from some women. We appreciated the initiative to check in with us on dicey plays, injuries, and congratulate our plays. We loved that you learned our cheer and helped cheer it from the sideline. "},{"game_id":297,"givenby":"Australia MX","cat1":2,"cat2":2,"cat3":2,"cat4":2,"cat5":2,"total":10,"comments":null},{"game_id":300,"givenby":"USA MX","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":"Thank you for a great game! I was given feedback after the game there was a lot of contact on the marks from our O handlers throughout the game. We appreciate the grind and the physicality Canada always brings. Opening up the field with your deep cuts and flow was hard to adjust to! Keep grinding and can’t wait to play against y'all again in the future! "},{"game_id":305,"givenby":"Colombia MX","cat1":2,"cat2":1,"cat3":2,"cat4":2,"cat5":2,"total":9,"comments":null}],"spiritstats":{"games":12},"spirittotal":{"total":117}}